{
  "name": "dx-jquery",
  "version": "1.0.0",
  "scripts": {
    "start": "vite",
    "prebuild": "devextreme-license --non-modular --out src/devextreme-license.js --force",
    "build": "npm run lint",
    "lint-html": "prettier --check src/*",
    "lint-js": "eslint .",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx src/ --fix",
    "lint-css": "stylelint src/**/*.css --allow-empty-input",
    "lint": "npm-run-all -p -c lint-js lint-css lint-html"
  },
  "devDependencies": {
    "@babel/core": "^7.22.1",
    "@babel/eslint-parser": "^7.21.8",
    "eslint": "9.18.0",
    "eslint-config-devextreme": "1.1.9",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "htmlhint": "^1.1.4",
    "npm-run-all": "^4.1.5",
    "prettier": "2.8.8",
    "stylelint": "^15.6.1",
    "stylelint-config-standard": "^33.0.0"
  },
  "dependencies": {
    "devextreme": "26.1.2-beta",
    "devextreme-dist": "26.1.2-beta",
    "devextreme-quill": "^1.7.3",
    "jquery": "^3.7.1",
    "openai": "^5.9.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "type": "module"
}
